{
  "name": "ocr-service",
  "version": "1.0.0",
  "description": "",
  "main": "build/index.js",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check \"src/**/*.{js,ts,tsx,md,json}\" \"test/**/*.ts\" && tsc --noEmit",
    "prettier:write": "prettier --write \"src/**/*.{js,ts,tsx,md,json}\" \"test/**/*.ts\"",
    "prettier:check": "prettier --check \"src/**/*.{js,ts,tsx,md,json}\"",
    "dev": "nodemon",
    "build": "rimraf build && tsc",
    "start": "node build/index.js",
    "worker": "node build/worker.js",
    "worker:dev": "ts-node src/worker.ts",
    "provision:tenant": "ts-node src/scripts/provision-tenant.ts",
    "provision:admin": "ts-node src/scripts/provision-admin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "ajv": "^8.17.1",
    "bullmq": "^5.34.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "file-type": "^16.5.4",
    "ioredis": "^5.4.2",
    "mammoth": "^1.9.0",
    "morgan": "^1.10.1",
    "mrz": "^4.0.0",
    "multer": "^2.1.1",
    "openai": "^6.34.0",
    "p-limit": "^3.1.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^5.0.0",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.3",
    "@types/turndown": "^5.0.5",
    "eslint": "^10.1.0",
    "nodemon": "^3.1.14",
    "pg-mem": "^3.0.14",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
